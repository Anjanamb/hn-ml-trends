# Ollama endpoint (default assumes local install).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Hacker News API needs no authentication; kept here for future
# per-user overrides (e.g. proxying through a rate-limited endpoint).
HN_API_BASE_URL=https://hacker-news.firebaseio.com/v0
